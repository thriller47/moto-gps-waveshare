# Preserve third-party license text exactly as supplied.
LICENSES/** -whitespace
# Retain the font converter's generated formatting.
shared/nav_ui/assets/moto_font_nav_16.c -whitespace
*.sqlite binary
*.png binary
*.pdf binary
*.docx binary
*.zip binary
# Preserve archived CAD exports and reports byte-for-byte for SHA-256 checks.
hardware/** -text -whitespace
docs/technical-proposal/** -text -whitespace

# Keep Bash scripts executable by Linux/WSL even when checked out on Windows.
*.sh text eol=lf
