# Waveshare ESP32-S3-Touch-AMOLED-1.75C: 32 MB QIO flash and 8 MB octal PSRAM.
# These values match the official ESP-IDF example for this exact board.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="32MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
# In radio mode the I2S DMA buffers must remain in scarce internal SRAM.
# Prefer PSRAM for ordinary allocations >=512 bytes (including codec working
# buffers where the codec uses malloc); DMA-capable allocations still use the
# requested heap capabilities. Applied on a fresh sdkconfig or via menuconfig.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=49152
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_INTERNAL=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=n
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y

# The board port supplies its own PSRAM draw buffers and explicitly opts into
# direct PSRAM DMA. Queue up to 10 QSPI transactions to prevent DMA TX underflows
# during task switching and initial bitmap draw flushes.
CONFIG_BSP_LCD_TRANS_QUEUE_DEPTH=10
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# The Waveshare USB-C connector is native ESP32-S3 USB Serial/JTAG (GPIO19/20).
# UART0 (GPIO43/44) is only on the expansion header, so UART-primary stdin
# cannot receive Arduino IDE Monitor commands sent over USB-C.
# Select USB Serial/JTAG as the PRIMARY console, for bidirectional stdin.
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# LVGL timing and the official BSP worker both use millisecond-scale scheduling.
CONFIG_FREERTOS_HZ=1000
CONFIG_LV_DEF_REFR_PERIOD=25
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Creating the complete four-page LVGL instrument UI calls deeply into LVGL
# after the vendor BSP has initialized the display. The ESP-IDF default 3584
# byte app_main stack overflows during that one-time startup on real hardware.
# In SIGNAL lab mode the same main task also parses/decodes streaming MP3.
# Keep 24 KiB on the main task for MP3 decoding, leaving 8 KiB more
# internal SRAM for I2S DMA descriptors and navigation task metadata.
# A fresh sdkconfig reconfigure is required if an older value is cached.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=24576

# NimBLE is the phone transport. Bluetooth Classic is intentionally disabled
# on ESP32-S3 and not required by the navigation link.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_GAP_SERVICE=y
CONFIG_BT_NIMBLE_GATT_SERVER=y
CONFIG_BT_NIMBLE_GATT_CLIENT=y
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n
CONFIG_BT_NIMBLE_NVS_PERSIST=n
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=185

# SIGNAL radio lab: keep the MP3 frame decoder enabled for Radio Paradise.
# The simple MP3 parser alone is insufficient to decode audio frames.
CONFIG_AUDIO_DECODER_MP3_SUPPORT=y

# Verify HTTPS radio station TLS certificates using Espressif root CAs.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_DEFAULT_CERTIFICATE_BUNDLE=y

# Isolate the radio HTTP/TLS task's 6 KiB stack in PSRAM. This avoids
# consuming internal heap needed when the MP3 decoder initializes lazily.
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
