# Core telemetry defaults enabled in the standard valhalla firmware from
# 12 November 2026; keep combined with sdkconfig.defaults.
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y
# ESP-IDF 5.5 gates TaskStatus_t.xCoreID behind this option.
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
